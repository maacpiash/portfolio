---
import ACLogo from '../assets/ac-logo.svg?raw'
import ThemeToggle from './ThemeToggle.astro'
import Icon, { type Props as IconProps } from './ui/Icon.astro'
import styles from './Nav.module.scss'

/** Main menu items */
const textLinks: { label: string; href: string; icon: IconProps['icon'] }[] = [
	{ label: 'Home', href: '/', icon: 'home' },
	{ label: 'About', href: '/about', icon: 'person' },
	{ label: 'Projects', href: '/projects', icon: 'computer' },
	{ label: 'Contact', href: '/contact', icon: 'at' },
]

/** Icon links to social media — edit these with links to your profiles! */
const iconLinks: { label: string; href: string; icon: IconProps['icon'] }[] = [
	{
		label: 'GitHub',
		href: 'https://github.com/maacpiash',
		icon: 'github-logo',
	},
	{
		label: 'LinkedIn',
		href: 'https://www.linkedin.com/in/maacpiash',
		icon: 'linkedin',
	},
	{
		label: 'Mastodon',
		href: 'https://mastodon.social/@maacpiash',
		icon: 'mastodon',
	},
	{
		label: 'PGP public key for contact@ahadchowdhury.com',
		href: '/pgp/contact@ahadchowdhury.com.asc',
		icon: 'key',
	},
	{
		label: 'PGP public key for ahad@maacpiash.com',
		href: '/pgp/ahad@maacpiash.com.asc',
		icon: 'key',
	},
]
---

<nav class={styles.root}>
	<div class={styles['menu-header']}>
		<a href="/" class={styles['site-title']}>
			<Fragment set:html={ACLogo} />
			Ahad Chowdhury
		</a>
		<button class={`menu-button ${styles['menu-button']}`} type="button" aria-expanded="false">
			<span class="sr-only">Menu</span>
			<Icon icon="list" />
		</button>
	</div>
	<div class={`mobile-menu ${styles['mobile-menu']}`} hidden>
		<div class={styles['mobile-menu-inner']}>
			<div class={styles.socials}>
				{
					iconLinks.map(({ href, icon, label }) => (
						<a href={href} class={styles.social} target="_blank" title={label}>
							<span class="sr-only">{label}</span>
							<Icon icon={icon} />
						</a>
					))
				}

				<div class={styles['theme-toggle']}>
					<ThemeToggle />
				</div>
			</div>
		</div>
	</div>
	<div id="menu-content" class="nav-hidden">
		<ul class={styles['nav-items']}>
			{
				textLinks.map(({ label, href, icon }) => (
					<li>
						<a
							aria-current={Astro.url.pathname === href}
							class:list={[
								styles.link,
								{
									[styles.active]:
										Astro.url.pathname === href ||
										(href !== '/' && Astro.url.pathname.startsWith(href)),
								},
							]}
							href={href}
						>
							<span class={styles['link-icon']} aria-hidden="true">
								<Icon icon={icon} />
							</span>
							<span class={styles['link-label']}>{label}</span>
						</a>
					</li>
				))
			}
		</ul>
		<div class={styles['menu-footer']}>
			<div class={styles.socials}>
				{
					iconLinks.map(({ href, icon, label }) => (
						<a href={href} class={styles.social} target="_blank" title={label}>
							<span class="sr-only">{label}</span>
							<Icon icon={icon} />
						</a>
					))
				}
			</div>

			<div class={styles['theme-toggle']}>
				<ThemeToggle />
			</div>
		</div>
	</div>
</nav>

<script>
	if (typeof window !== 'undefined') {
		let hideTimer: number | undefined
		const mq = window.matchMedia('(min-width: 50em)')

		const showNav = () => {
			if (mq.matches) return
			const menuContent = document.getElementById('menu-content')
			if (!menuContent) return
			menuContent.classList.add('nav-visible')
			menuContent.classList.remove('nav-hidden')
		}

		const hideNav = () => {
			if (mq.matches) return
			const menuContent = document.getElementById('menu-content')
			if (!menuContent) return
			menuContent.classList.add('nav-hidden')
			menuContent.classList.remove('nav-visible')
		}

		const scheduleHide = () => {
			if (hideTimer !== undefined) {
				window.clearTimeout(hideTimer)
			}
			hideTimer = window.setTimeout(() => {
				hideNav()
			}, 5000)
		}
		const onScroll = () => {
			showNav()
			scheduleHide()
		}
		window.addEventListener('scroll', onScroll, { passive: true })

		// Use event delegation so this keeps working after client-side navigations.
		document.addEventListener('click', (event) => {
			const target = event.target as HTMLElement | null
			if (!target) return
			const menuButton = target.closest<HTMLButtonElement>('.menu-button')
			if (!menuButton) return

			const nav = menuButton.closest('nav')
			const mobileMenu = nav?.querySelector<HTMLElement>('.mobile-menu')
			if (!mobileMenu) return

			const expanded = menuButton.getAttribute('aria-expanded') === 'true'
			const next = !expanded
			menuButton.setAttribute('aria-expanded', next ? 'true' : 'false')
			mobileMenu.hidden = !next
		})
	}
</script>
